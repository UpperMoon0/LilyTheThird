#:kivy 2.0.0

<ServiceStatus>:
    orientation: 'horizontal'
    size_hint_y: None
    height: dp(40)
    padding: dp(10)
    spacing: dp(10)
    
    canvas.before:
        Color:
            rgba: 0.3, 0.3, 0.3, 1  # Dark gray background
        Rectangle:
            pos: self.pos
            size: self.size
        Color:
            rgba: 0.5, 0.5, 0.5, 1  # Border color (gray)
        Line:
            rectangle: self.x + dp(1), self.y + dp(1), self.width - dp(2), self.height - dp(2)
            width: 1  # Border width

    # Status indicator (colored circle)
    Widget:
        size_hint_x: None
        width: dp(20)
        canvas.before:
            Color:
                rgba: (0, 1, 0, 1) if root.is_healthy else (1, 0, 0, 1)  # Green if healthy, red if not
            Ellipse:
                pos: self.center_x - dp(8), self.center_y - dp(8)
                size: dp(16), dp(16)

    # Service name
    Label:
        text: root.service_name
        halign: 'left'
        valign: 'middle'
        text_size: self.size
        font_size: '14sp'
        bold: True
        size_hint_x: None
        width: dp(100)

    # Status text
    Label:
        text: root.status_text
        halign: 'left'
        valign: 'middle'
        text_size: self.size
        font_size: '14sp'
        color: (0, 1, 0, 1) if root.is_healthy else (1, 1, 1, 1)  # Green text if healthy, white if not