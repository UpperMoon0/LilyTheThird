#:kivy 2.0.0
#:import ScrollView kivy.uix.scrollview.ScrollView
#:import Label kivy.uix.label.Label

<MonitorTab>:
    orientation: 'vertical'
    padding: dp(10)
    spacing: dp(10)
    
    # Header with title and refresh button
    BoxLayout:
        size_hint_y: None
        height: dp(40)
        spacing: dp(10)
        
        Label:
            text: "System Monitor"
            font_size: '18sp'
            bold: True
            halign: 'left'
            valign: 'middle'
            
        Widget:
            size_hint_x: 1
            
        Button:
            text: "Refresh"
            size_hint_x: None
            width: dp(100)
            on_press: root.refresh_data()
    
    # Status indicator
    BoxLayout:
        size_hint_y: None
        height: dp(50)
        padding: dp(10)
        spacing: dp(10)
        canvas.before:
            Color:
                rgba: 0.3, 0.3, 0.3, 1  # Dark gray background
            Rectangle:
                pos: self.pos
                size: self.size
            Color:
                rgba: 0.5, 0.5, 0.5, 1  # Border color (gray)
            Line:
                rectangle: self.x + dp(1), self.y + dp(1), self.width - dp(2), self.height - dp(2)
                width: 1  # Border width

        # Status indicator (colored circle)
        Widget:
            size_hint_x: None
            width: dp(20)
            canvas.before:
                Color:
                    rgba: (0, 1, 0, 1) if root.is_connected else (1, 0, 0, 1)  # Green if connected, red if not
                Ellipse:
                    pos: self.center_x - dp(8), self.center_y - dp(8)
                    size: dp(16), dp(16)

        # Status text
        Label:
            text: "Status: " + root.connection_status
            halign: 'left'
            valign: 'middle'
            text_size: self.size
            font_size: '16sp'
            color: (0, 1, 0, 1) if root.is_connected else (1, 1, 1, 1)  # Green text if connected, white if not
    
    # System metrics
    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(100)
        spacing: dp(10)
        
        # CPU Usage
        BoxLayout:
            orientation: 'vertical'
            canvas.before:
                Color:
                    rgba: 0.2, 0.2, 0.2, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
                    
            Label:
                text: "CPU Usage"
                size_hint_y: None
                height: dp(25)
                bold: True
                
            Label:
                text: root.cpu_usage
                font_size: '24sp'
                color: 0, 1, 0, 1  # Green
                
        # Memory Usage
        BoxLayout:
            orientation: 'vertical'
            canvas.before:
                Color:
                    rgba: 0.2, 0.2, 0.2, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
                    
            Label:
                text: "Memory"
                size_hint_y: None
                height: dp(25)
                bold: True
                
            Label:
                text: root.memory_usage
                font_size: '24sp'
                color: 0, 1, 0, 1  # Green
                
        # Response Time
        BoxLayout:
            orientation: 'vertical'
            canvas.before:
                Color:
                    rgba: 0.2, 0.2, 0.2, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
                    
            Label:
                text: "Response Time"
                size_hint_y: None
                height: dp(25)
                bold: True
                
            Label:
                text: root.response_time
                font_size: '24sp'
                color: 0, 1, 0, 1  # Green
    
    # Service statuses
    BoxLayout:
        orientation: 'vertical'
        size_hint_y: None
        height: dp(150)
        spacing: dp(10)
        
        Label:
            text: "Service Statuses"
            size_hint_y: None
            height: dp(30)
            bold: True
            halign: 'left'
            
        BoxLayout:
            orientation: 'horizontal'
            spacing: dp(10)
            
            # Lily Core Status
            BoxLayout:
                orientation: 'vertical'
                canvas.before:
                    Color:
                        rgba: 0.2, 0.2, 0.2, 1
                    Rectangle:
                        pos: self.pos
                        size: self.size
                        
                Label:
                    text: "Lily Core"
                    size_hint_y: None
                    height: dp(25)
                    bold: True
                    
                BoxLayout:
                    size_hint_y: None
                    height: dp(25)
                    spacing: dp(5)
                    
                    Widget:
                        size_hint_x: None
                        width: dp(15)
                        canvas.before:
                            Color:
                                rgba: (0, 1, 0, 1) if root.lily_core_healthy else (1, 0, 0, 1)
                            Ellipse:
                                pos: self.center_x - dp(6), self.center_y - dp(6)
                                size: dp(12), dp(12)
                                
                    Label:
                        text: root.lily_core_status
                        color: (0, 1, 0, 1) if root.lily_core_healthy else (1, 1, 1, 1)
                        
            # TTS Provider Status
            BoxLayout:
                orientation: 'vertical'
                canvas.before:
                    Color:
                        rgba: 0.2, 0.2, 0.2, 1
                    Rectangle:
                        pos: self.pos
                        size: self.size
                        
                Label:
                    text: "TTS Provider"
                    size_hint_y: None
                    height: dp(25)
                    bold: True
                    
                BoxLayout:
                    size_hint_y: None
                    height: dp(25)
                    spacing: dp(5)
                    
                    Widget:
                        size_hint_x: None
                        width: dp(15)
                        canvas.before:
                            Color:
                                rgba: (0, 1, 0, 1) if root.tts_provider_healthy else (1, 0, 0, 1)
                            Ellipse:
                                pos: self.center_x - dp(6), self.center_y - dp(6)
                                size: dp(12), dp(12)
                                
                    Label:
                        text: root.tts_provider_status
                        color: (0, 1, 0, 1) if root.tts_provider_healthy else (1, 1, 1, 1)
                        
            # Web Scout Status
            BoxLayout:
                orientation: 'vertical'
                canvas.before:
                    Color:
                        rgba: 0.2, 0.2, 0.2, 1
                    Rectangle:
                        pos: self.pos
                        size: self.size
                        
                Label:
                    text: "Web Scout"
                    size_hint_y: None
                    height: dp(25)
                    bold: True
                    
                BoxLayout:
                    size_hint_y: None
                    height: dp(25)
                    spacing: dp(5)
                    
                    Widget:
                        size_hint_x: None
                        width: dp(15)
                        canvas.before:
                            Color:
                                rgba: (0, 1, 0, 1) if root.web_scout_healthy else (1, 0, 0, 1)
                            Ellipse:
                                pos: self.center_x - dp(6), self.center_y - dp(6)
                                size: dp(12), dp(12)
                                
                    Label:
                        text: root.web_scout_status
                        color: (0, 1, 0, 1) if root.web_scout_healthy else (1, 1, 1, 1)
    
    # Recent events
    BoxLayout:
        orientation: 'vertical'
        spacing: dp(5)
        
        Label:
            text: "Recent Events"
            size_hint_y: None
            height: dp(30)
            bold: True
            halign: 'left'
            
        ScrollView:
            do_scroll_x: False
            bar_width: dp(10)
            
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: max(len(root.recent_events) * dp(25), dp(25))
                spacing: dp(2)
                
                # Use a dynamic approach to display events
                canvas.before:
                    Color:
                        rgba: 0.1, 0.1, 0.1, 1
                    Rectangle:
                        pos: self.pos
                        size: self.size
                        
                Label:
                    text: '\n'.join(root.recent_events[-20:]) if root.recent_events else "No events yet"
                    halign: 'left'
                    valign: 'top'
                    text_size: self.width, None
                    size_hint_y: None
                    height: max(self.texture_size[1], dp(25))
                    font_size: '12sp'
                    color: 1, 1, 1, 1